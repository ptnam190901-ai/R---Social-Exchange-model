htmt(model.cfa, dat)
model.sem1 <- ' First model where all latent variables have a direct only effect on TQM
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
SAT =~ q18 + q19 + q20 + q21 + q22
TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
TQM ~ LMX + TMX + EFF + SAT'
fit.sem1 <- sem(model.sem1, dat) # Fit the SEM model 1
model.sem1 <- ' # First model where all latent variables have a direct only effect on TQM
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
SAT =~ q18 + q19 + q20 + q21 + q22
TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
TQM ~ LMX + TMX + EFF + SAT'
model.sem1 <- '
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
