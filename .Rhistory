model.sem2 <- '
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
SAT =~ q18 + q19 + q20 + q21 + q22
TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
EFF ~ LMX + TMX
SAT ~ LMX + TMX
TQM ~ LMX + TMX + EFF + SAT'
model.net <- '
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
SAT =~ q18 + q19 + q20 + q21 + q22
TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
EFF ~ LMX + a1*TMX
SAT ~ LMX + a2*TMX
TQM ~ b1*EFF + b2*SAT + LMX + b3*TMX
b_ind := a1*b1+a2*b2
b_net := b_ind + b3'
fit.net <- sem(model.net, dat)
summary(fit.net, fit.measures = TRUE)
