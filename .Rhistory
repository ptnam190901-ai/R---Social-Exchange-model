dat <- read.csv(file.choose()) # Import the data
install.packages("lavaan", type = "binary") # Import the lavaan package
install.packages("semTools", type = "binary") # Import the semTools package
dat <- read.csv(file.choose()) # Import the data
install.packages("lavaan", type = "binary") # Import the lavaan package
install.packages("semTools", type = "binary") # Import the semTools package
install.packages("psych", type = "binary") # Import the package psych
library(lavaan) # Apply the lavaan library
library(semTools) # Apply the semTools library
library("psych") # Apply the psych library
fit.efa <- efa(dat, nfactors = 5, rotation = "oblimin")
scree(dat) # Create a scree plot of data
# There are five factors whose eigenvalues are over 1, so it can be said that in this case, the appropriate number of factors is 5
KMO(dat) # Examine Kaiser-Meyer-Olkin index
# The value of KMO test is over 0.5, so the data is sufficient
det(cov(dat)) # Conduct determinant of covariance test
# The number is too small, so it is not likely to cause multicollinearity
summary(fit.efa, fit.measures = TRUE) # Running summary of EFA
# With values over 0.6, these values show the association between 5 factors LMX, TMX, EFF, SAT and TQM
model.cfa <- ' # Settle the CFA model
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
SAT =~ q18 + q19 + q20 + q21 + q22
TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7’
