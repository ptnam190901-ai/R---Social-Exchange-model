dat <- read.csv(file.choose()) # Import the data
install.packages("lavaan", type = "binary") # Import the lavaan package
install.packages("semTools", type = "binary") # Import the semTools package
install.packages("semPlot", type = "binary") # Import the semPlot package
install.packages("psych", type = "binary") # Import the package psych
library(lavaan) # Apply the lavaan library
library(semTools) # Apply the semTools library
library(semPlot) # Apply the semPlot library
library("psych") # Apply the psych library
fit.efa <- efa(dat, nfactors = 5, rotation = "oblimin")
scree(dat) # Create a scree plot of data
# There are five factors whose eigenvalues are over 1, so it can be said that in this case, the appropriate number of factors is 5
KMO(dat) # Examine Kaiser-Meyer-Olkin index
# The value of KMO test is over 0.5, so the data is sufficient
det(cov(dat)) # Conduct determinant of covariance test
# The number is too small, so it is not likely to cause multicollinearity
summary(fit.efa, fit.measures = TRUE) # Running summary of EFA
# With values over 0.6, these values show the association between 5 factors LMX, TMX, EFF, SAT and TQM
model.cfa <- ' # Settle the CFA model
LMX =~ q1 + q2 + q3 + q4 + q5 + q6
TMX =~ q7 + q8 + q9 + q10 + q11 + q12
EFF =~ q13 + q14 + q15 + q16 + q17
SAT =~ q18 + q19 + q20 + q21 + q22
TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7'
fit.cfa <- cfa(model.cfa, dat) # Fit the CFA model
summary(fit.cfa, fit.measures = TRUE) # Running summary of CFA model
compRelSEM(fit.cfa) # Measures the reliability of the CFA model
AVE(fit.cfa) # Measures the convergent validity of the CFA model
htmt(model.cfa, dat) # Measures the discriminant validity of the CFA model
model.sem1 <- ' # First model where all latent variables have a direct only effect on TQM
  LMX =~ q1 + q2 + q3 + q4 + q5 + q6
  TMX =~ q7 + q8 + q9 + q10 + q11 + q12
  EFF =~ q13 + q14 + q15 + q16 + q17
  SAT =~ q18 + q19 + q20 + q21 + q22
  TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
  TQM ~ LMX + TMX + EFF + SAT'
fit.sem1 <- sem(model.sem1, dat) # Fit the SEM model 1
compRelSEM(fit.sem1) # Measures the reliability of the SEM model 1
AVE(fit.sem1) # Measures the convergent validity of the SEM model 1
htmt(model.sem1, dat) # Measures the discriminant validity of the SEM model 1
summary(fit.sem1, fit.measures = TRUE) # Running summary of SEM model 1
model.sem2 <- ' # Second model where LMX and TMX have direct effects on TQM, EFF and SAT, and EFF and SAT have a direct effect on TQM
  LMX =~ q1 + q2 + q3 + q4 + q5 + q6
  TMX =~ q7 + q8 + q9 + q10 + q11 + q12
  EFF =~ q13 + q14 + q15 + q16 + q17
  SAT =~ q18 + q19 + q20 + q21 + q22
  TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
  EFF ~ LMX + TMX
  SAT ~ LMX + TMX
  TQM ~ LMX + TMX + EFF + SAT’
fit.sem2 <- sem(model.sem2, dat) # Fit the SEM model 2
compRelSEM(fit.sem2) # Measures the reliability of the SEM model 2
AVE(fit.sem2) # Measures the convergent validity of the SEM model 2
htmt(model.sem2, dat) # Measures the discriminant validity of the SEM model 2
summary(fit.sem2, fit.measures = TRUE) # Running summary of SEM model 2
# AIC and BIC of model 2 are lower than those of model 1, so model 2 is the better model
model.net <- ' # Built the model tp validate the mediated effect of TMX
  LMX =~ q1 + q2 + q3 + q4 + q5 + q6
  TMX =~ q7 + q8 + q9 + q10 + q11 + q12
  EFF =~ q13 + q14 + q15 + q16 + q17
  SAT =~ q18 + q19 + q20 + q21 + q22
  TQM =~ r1 + r2 + r3 + r4 + r5 + r6 + r7
  EFF ~ LMX + a1*TMX
  SAT ~ LMX + a2*TMX
  TQM ~ b1*EFF + b2*SAT + LMX + b3*TMX
b_ind := a1*b1+a2*b2
b_net := b_ind + b3'
fit.net <- sem(model.net, dat) # Fit the net model
summary(fit.net, fit.measures = TRUE) # Running summary of net effect model 
